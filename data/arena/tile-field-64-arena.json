  "designIntent": {
    "court": "2v2 tennis-like grass court centered inside a compact field arena.",
    "decor": "Top-down tile-field reference translated into low-cost 3D primitives: grass, sand paths, rope fence, corner spectator decks, trees, benches, lamps, shrubs, and signs.",
    "mobileBudget": "Keep total BasePart count under 120 by using large surfaces and repeated primitive props instead of one part per visual tile."
  },
  "collisionContract": {
    "collidable": [
      "Foundation/BaseGrass",
      "Foundation/CourtGrass",
      "Foundation/Path*"
    ],
    "nonCollidable": [
      "Court/CourtLines/*",
      "Court/Net/*",
      "Fences/*",
      "SpectatorPlatforms/*",
      "Props/*",
      "Decor/*"
    ],
    "notes": [
      "Decorative posts, trees, signs, benches, lamps, and platforms use CanCollide=false, CanTouch=false, and CanQuery=false to avoid player snagging.",
      "The arena floor is one broad smooth collider. Existing TDServer player clamping should remain responsible for match bounds.",
      "The model is stored under ServerStorage so it can be cloned into Workspace when needed."
    ]
  },
  "folders": [
    "Foundation",
    "Court",
    "Court/CourtLines",
    "Court/Net",
    "Fences",
    "SpectatorPlatforms",
    "Props",
    "Decor",
    "Collision"
